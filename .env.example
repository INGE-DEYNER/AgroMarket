# Example environment variables for AgroMarket
# Copy to .env and fill values for your environment

# Database
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
DB_USERNAME=agromarket_user
DB_PASSWORD=agromarket_pass
DB_HOST=localhost
DB_PORT=33060
DB_NAME=agromarket_db
DB_HIKARI_MAX_POOL=20
DB_HIKARI_MIN_IDLE=5

# MongoDB (auditoría de autenticación y sesiones)
MONGO_URI=mongodb://localhost:27018/agromarket_auth
MONGO_DATABASE=agromarket_auth

# JWT
JWT_SECRET=change-this-secret-in-production-min-256-bits

# OAuth2 Google (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=979388358435-5meqv2lerjjaipdqcg6eot18h9m5ht3p.a pps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-kDplyAOszg6W4lsnVuT-00xmwC-
APP_FRONTEND_URL=http://localhost:5174

# Mail (for local testing you can use mailhog at localhost:1025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Application
UPLOADS_PATH=uploads
CACHE_TTL_SECONDS=30
SERVER_PORT=8080
CONTEXT_PATH=/
APP_ENV=development

# Rate limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_VERIFY_EMAIL_ATTEMPTS=3
RATE_LIMIT_VERIFY_EMAIL_WINDOW_MINUTES=60
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://agromarket.local
# LOGGING
LOG_LEVEL=INFO

# COMPRESSION
COMPRESSION_ENABLED=true
COMPRESSION_MIN_SIZE=1024
