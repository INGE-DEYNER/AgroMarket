# Copia este archivo a .env y rellena los valores. El .env NO se versiona.
#
#   cp .env.example .env
#   node scripts/crea-secretos.cjs     <- genera los secretos que falten
#
# Formato exigido por cada clave:
#
# JWT_SECRET
#   Firma los tokens. HS512 necesita 64 bytes como minimo, asi que 72
#   caracteres. Alfanumerico, sin + / ni =: el parser del .env de Docker
#   Compose puede recortar un valor con esos simbolos.
#
# APP_SECURITY_ID_ENCRYPTION_KEY
#   Cifra los identificadores. Debe ser Base64 de 16, 24 o 32 bytes. La forma
#   de 32 bytes son 44 caracteres y hay que entrecomillarla en el .env.
#
# MYSQL_PASSWORD
#   SOLO se lee al crear el volumen de MySQL. Si cambias el valor despues sin
#   recrear el volumen, el backend deja de poder conectarse.
#
# MERCADOPAGO_WEBHOOK_SECRET
#   Sin ella el webhook rechaza TODOS los eventos, que es lo correcto: mejor
#   que aceptar pagos falsos. Sale del panel de MercadoPago.

# --- seguridad de la aplicacion ---
JWT_SECRET=
APP_SECURITY_ID_ENCRYPTION_KEY=

# --- base de datos ---
MYSQL_USER=agromarket
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- pagos ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- imagenes ---
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- correo ---
BREVO_API_KEY=