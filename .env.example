# Copia este archivo a .env y rellena los valores. El .env NO se versiona.
#
#   cp .env.example .env
#   node scripts/crea-secretos.cjs     <- genera los secretos que falten
#
# Formato exigido por cada clave:
#
# JWT_SECRET
#   Firma los tokens. HS512 necesita 64 bytes como minimo, asi que 72
#   caracteres. Alfanumerico, sin + / ni =: el parser del .env de Docker
#   Compose puede recortar un valor con esos simbolos.
#
# APP_SECURITY_ID_ENCRYPTION_KEY
#   Cifra los identificadores. Debe ser Base64 de 16, 24 o 32 bytes. La forma
#   de 32 bytes son 44 caracteres y hay que entrecomillarla en el .env.
#
# MYSQL_PASSWORD
#   SOLO se lee al crear el volumen de MySQL. Si cambias el valor despues sin
#   recrear el volumen, el backend deja de poder conectarse.
#
# MERCADOPAGO_WEBHOOK_SECRET
#   Sin ella el webhook rechaza TODOS los eventos, que es lo correcto: mejor
#   que aceptar pagos falsos. Sale del panel de MercadoPago.

# --- soporte ---
# Buzon donde llegan los reportes de "Reportar un problema".
#
# Confirmado por ASAFRUT. Es el mismo correo que muestra el sitio, asi que el
# cliente escribe a un sitio y el reporte llega al mismo sitio.
#
# OJO: esto solo define A QUIEN le llega. El correo sale por Brevo, que exige
# que el REMITENTE este verificado en https://app.brevo.com. Si
# BREVO_SENDER_EMAIL no esta verificado, la API responde 403 y no sale nada,
# aunque este valor este bien. Es el segundo requisito, y es el que mas se
# olvida.
#
# Para recuperar los reportes a mano mientras tanto:
#   mongosh --eval 'db.support_reports.find().sort({_id:-1}).limit(20)'
APP_SUPPORT_EMAIL=soporte@agro-market.app

# --- seguridad de la aplicacion ---
JWT_SECRET=
APP_SECURITY_ID_ENCRYPTION_KEY=

# --- base de datos ---
MYSQL_USER=agromarket
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=agromarket
MYSQL_PORT_HOST=3307

# --- MongoDB ---
# MONGO_ROOT_PASSWORD es obligatoria en docker-compose.yml. Antes valía
# "root123" y estaba escrita en el compose, con el puerto 27018 abierto a
# cualquiera que llegara al servidor.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=agromarket
MONGO_PORT_HOST=27018

# --- pagos ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- imagenes ---
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- correo ---
# Brevo necesita ademas un remitente verificado en https://app.brevo.com.
# Si no lo esta, la API responde 403 y los correos no salen.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AgroMarket