<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ðŸ§ª AgroMarket â€” Smoke Test</title>
    <style>
      :root {
        --bg: #081018;
        --panel: #0f1a24;
        --panel-2: #122131;
        --text: #e8f0f7;
        --muted: #9fb2c3;
        --line: rgba(255, 255, 255, 0.08);
        --green: #61d095;
        --green-2: #1f7a3a;
        --yellow: #ffd166;
        --red: #ff6b6b;
        --blue: #7ab7ff;
        --shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
        --radius: 18px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Inter, Arial, sans-serif;
        color: var(--text);
        background:
          radial-gradient(
            circle at top left,
            rgba(122, 183, 255, 0.18),
            transparent 32%
          ),
          radial-gradient(
            circle at 80% 10%,
            rgba(97, 208, 149, 0.16),
            transparent 28%
          ),
          linear-gradient(180deg, #081018 0%, #0b1620 100%);
        min-height: 100vh;
        padding: 32px 18px 48px;
      }

      .shell {
        max-width: 1080px;
        margin: 0 auto;
      }

      .hero {
        padding: 28px 28px 20px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: rgba(15, 26, 36, 0.72);
        backdrop-filter: blur(16px);
        box-shadow: var(--shadow);
        margin-bottom: 22px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(122, 183, 255, 0.12);
        border: 1px solid rgba(122, 183, 255, 0.22);
        color: #d9eaff;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        margin-bottom: 14px;
      }

      h1 {
        margin: 0 0 8px;
        font-size: clamp(2rem, 4vw, 3.4rem);
        line-height: 1.05;
      }

      .sub {
        margin: 0;
        color: var(--muted);
        max-width: 760px;
        font-size: 0.98rem;
        line-height: 1.55;
      }

      .grid {
        display: grid;
        gap: 16px;
      }

      .test-card {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: linear-gradient(
          180deg,
          rgba(18, 33, 49, 0.96),
          rgba(15, 26, 36, 0.92)
        );
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .test-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--line);
      }

      .test-title {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .test-title strong {
        font-size: 1rem;
      }

      .test-title span {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      button {
        border: 0;
        border-radius: 12px;
        padding: 12px 14px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition:
          transform 0.12s ease,
          opacity 0.12s ease,
          box-shadow 0.12s ease;
      }

      button:hover {
        transform: translateY(-1px);
      }

      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
      }

      .primary {
        background: linear-gradient(135deg, #61d095, #2e8f56);
        color: #06110b;
        box-shadow: 0 10px 30px rgba(97, 208, 149, 0.2);
      }

      .secondary {
        background: rgba(255, 255, 255, 0.06);
        color: var(--text);
        border: 1px solid var(--line);
      }

      .danger {
        background: rgba(255, 107, 107, 0.12);
        color: #ffd2d2;
        border: 1px solid rgba(255, 107, 107, 0.22);
      }

      .status {
        padding: 18px 20px 20px;
        display: grid;
        gap: 10px;
      }

      .status-line {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        line-height: 1.45;
      }

      .status-tag {
        min-width: 78px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        margin-top: 1px;
      }

      .pending {
        background: rgba(255, 209, 102, 0.12);
        color: #ffe8a2;
      }
      .ok {
        background: rgba(97, 208, 149, 0.14);
        color: #b9f2cf;
      }
      .error {
        background: rgba(255, 107, 107, 0.14);
        color: #ffc7c7;
      }
      .info {
        background: rgba(122, 183, 255, 0.14);
        color: #d6e7ff;
      }

      pre {
        margin: 0;
        white-space: pre-wrap;
        word-break: break-word;
        color: #dbe7f1;
        font-size: 0.86rem;
      }

      .tiny {
        color: var(--muted);
        font-size: 0.85rem;
      }

      .summary {
        margin-top: 18px;
        padding: 18px 20px;
        border-radius: var(--radius);
        border: 1px solid rgba(97, 208, 149, 0.16);
        background: rgba(97, 208, 149, 0.08);
      }

      .summary h2 {
        margin: 0 0 10px;
        font-size: 1rem;
      }

      .summary-list {
        display: grid;
        gap: 8px;
        margin: 0;
        padding-left: 18px;
        color: #dbe7f1;
      }

      .mono {
        font-family: Consolas, Monaco, monospace;
      }

      @media (max-width: 720px) {
        body {
          padding: 16px 12px 36px;
        }

        .hero,
        .test-head,
        .status,
        .summary {
          padding-left: 16px;
          padding-right: 16px;
        }

        .actions {
          width: 100%;
        }

        button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <section class="hero">
        <div class="eyebrow">ðŸ§ª AgroMarket â€” Smoke Test</div>
        <h1>ValidaciÃ³n manual de la integraciÃ³n frontend â†” backend</h1>
        <p class="sub">
          Ejecuta los flujos en orden. El test guarda token y sesiÃ³n en
          <span class="mono">localStorage</span>, consulta productos reales y
          crea un pedido usando el primer producto retornado por el catÃ¡logo.
        </p>
      </section>

      <section class="grid">
        <article class="test-card">
          <div class="test-head">
            <div class="test-title">
              <strong>FLUJO 1 â€” Login</strong>
              <span>Debe devolver token y guardar sesiÃ³n.</span>
            </div>
            <div class="actions">
              <button class="primary" id="btnLogin">â–¶ Ejecutar login</button>
            </div>
          </div>
          <div class="status">
            <div class="status-line">
              <span class="status-tag pending" id="loginTag">Pendiente</span>
              <pre id="loginOut">Pendiente...</pre>
            </div>
          </div>
        </article>

        <article class="test-card">
          <div class="test-head">
            <div class="test-title">
              <strong>FLUJO 2 â€” CatÃ¡logo (GET /api/productos)</strong>
              <span>Debe listar productos y permitir filtrar por BANANO.</span>
            </div>
            <div class="actions">
              <button class="primary" id="btnCatalogo">
                â–¶ Cargar productos
              </button>
              <button class="secondary" id="btnFiltrar">
                â–¶ Filtrar por BANANO
              </button>
            </div>
          </div>
          <div class="status">
            <div class="status-line">
              <span class="status-tag pending" id="catalogoTag">Pendiente</span>
              <pre id="catalogoOut">Pendiente...</pre>
            </div>
          </div>
        </article>

        <article class="test-card">
          <div class="test-head">
            <div class="test-title">
              <strong>FLUJO 3 â€” Crear pedido</strong>
              <span
                >Requiere haber corrido el Flujo 1 primero (necesita token).
                Toma el primer productoId del catÃ¡logo automÃ¡ticamente.</span
              >
            </div>
            <div class="actions">
              <button class="primary" id="btnPedido">
                â–¶ Crear pedido (cantidad: 1)
              </button>
            </div>
          </div>
          <div class="status">
            <div class="status-line">
              <span class="status-tag pending" id="pedidoTag">Pendiente</span>
              <pre id="pedidoOut">Pendiente...</pre>
            </div>
          </div>
        </article>

        <article class="test-card">
          <div class="test-head">
            <div class="test-title">
              <strong>FLUJO 4 â€” SesiÃ³n en localStorage</strong>
              <span
                >Verifica que nombre y rol queden guardados; tambiÃ©n permite
                limpiar la sesiÃ³n.</span
              >
            </div>
            <div class="actions">
              <button class="secondary" id="btnSesion">
                â–¶ Verificar sesiÃ³n guardada
              </button>
              <button class="danger" id="btnLimpiar">âœ• Limpiar sesiÃ³n</button>
            </div>
          </div>
          <div class="status">
            <div class="status-line">
              <span class="status-tag pending" id="sesionTag">Pendiente</span>
              <pre id="sesionOut">Pendiente...</pre>
            </div>
          </div>
        </article>
      </section>

      <section class="summary" id="summaryBox">
        <h2>Reporte de estado</h2>
        <ul class="summary-list" id="summaryList">
          <li>Ejecuta los flujos para ver el estado aquÃ­.</li>
        </ul>
      </section>
    </main>

    <script>
      const API_BASE = "http://localhost:8080/api";
      const STORAGE_TOKEN = "agro_token";
      const STORAGE_USER = "agro_user";
      const defaultCredentials = {
        correo: "maria@example.com",
        contrasena: "pass123",
      };
      let catalogoCache = [];

      function setStatus(tagId, outId, state, text) {
        const tag = document.getElementById(tagId);
        const out = document.getElementById(outId);
        if (tag) {
          tag.className = `status-tag ${state}`;
          tag.textContent =
            state === "ok"
              ? "OK"
              : state === "error"
                ? "ERROR"
                : state === "info"
                  ? "INFO"
                  : "PENDIENTE";
        }
        if (out) {
          out.textContent = text;
        }
      }

      function updateSummary(items) {
        const list = document.getElementById("summaryList");
        if (!list) return;
        list.innerHTML = items.map((item) => `<li>${item}</li>`).join("");
      }

      function tokenLabel(token) {
        return token ? `${token.slice(0, 16)}...` : "sin token";
      }

      async function loginFlow() {
        setStatus("loginTag", "loginOut", "info", "Ejecutando login...");
        try {
          const response = await fetch(`${API_BASE}/auth/login`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(defaultCredentials),
          });
          const payload = await response.json();
          if (!response.ok) {
            throw new Error(payload?.message || `HTTP ${response.status}`);
          }
          const data = payload.data || payload;
          localStorage.setItem(STORAGE_TOKEN, data.token || "");
          localStorage.setItem(
            STORAGE_USER,
            JSON.stringify({
              id: data.userId ?? data.idUsuario ?? null,
              nombre: data.nombre || "Usuario",
              correo: data.correo || defaultCredentials.correo,
              rol: String(data.rol || data.tipo || "").toLowerCase(),
            }),
          );
          setStatus(
            "loginTag",
            "loginOut",
            "ok",
            `Login correcto. Token: ${tokenLabel(data.token)}\nUsuario: ${data.nombre || "Usuario"}\nRol: ${data.rol || data.tipo || "desconocido"}`,
          );
          updateSummary([
            "Flujo 1: âœ… Login exitoso y sesiÃ³n guardada en localStorage.",
            `Token actual: ${tokenLabel(data.token)}`,
            "Puedes continuar con catÃ¡logo y pedido.",
          ]);
          return data;
        } catch (error) {
          setStatus(
            "loginTag",
            "loginOut",
            "error",
            `Login fallÃ³: ${error.message}`,
          );
          updateSummary([
            `Flujo 1: âŒ ${error.message}`,
            "Revisa backend, credenciales o el perfil dev.",
          ]);
          throw error;
        }
      }

      async function cargarCatalogo() {
        setStatus(
          "catalogoTag",
          "catalogoOut",
          "info",
          "Cargando productos...",
        );
        try {
          const response = await fetch(`${API_BASE}/productos?page=0&size=100`);
          const payload = await response.json();
          if (!response.ok) {
            throw new Error(payload?.message || `HTTP ${response.status}`);
          }
          const data = payload.data || payload;
          catalogoCache = data.content || data || [];
          const total = catalogoCache.length;
          const banano = catalogoCache.filter(
            (p) => String(p.tipoFruta || "").toUpperCase() === "BANANO",
          ).length;
          setStatus(
            "catalogoTag",
            "catalogoOut",
            "ok",
            `Productos cargados: ${total}\nCoincidencias BANANO: ${banano}\nPrimer producto: ${catalogoCache[0]?.nombre || "N/A"}`,
          );
          updateSummary([
            `Flujo 2: âœ… CatÃ¡logo cargado con ${total} producto(s).`,
            `Coincidencias BANANO: ${banano}.`,
            "El backend responde correctamente en /api/productos.",
          ]);
          return catalogoCache;
        } catch (error) {
          setStatus(
            "catalogoTag",
            "catalogoOut",
            "error",
            `CatÃ¡logo fallÃ³: ${error.message}`,
          );
          updateSummary([
            `Flujo 2: âŒ ${error.message}`,
            "Revisa CORS, permisos o DataInitializer.",
          ]);
          throw error;
        }
      }

      async function crearPedido() {
        setStatus("pedidoTag", "pedidoOut", "info", "Creando pedido...");
        try {
          const token = localStorage.getItem(STORAGE_TOKEN);
          if (!token) {
            throw new Error("No hay token. Ejecuta el Flujo 1 primero.");
          }
          if (!catalogoCache.length) {
            await cargarCatalogo();
          }
          const productoId = catalogoCache[0]?.id;
          if (!productoId) {
            throw new Error("No hay productoId disponible en el catÃ¡logo.");
          }
          const response = await fetch(`${API_BASE}/pedidos`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ productoId, cantidad: 1 }),
          });
          const payload = await response.json();
          if (!response.ok) {
            throw new Error(payload?.message || `HTTP ${response.status}`);
          }
          const data = payload.data || payload;
          setStatus(
            "pedidoTag",
            "pedidoOut",
            "ok",
            `Pedido creado correctamente.\nPedido ID: ${data.id || data.pedidoId || "N/A"}\nProducto: ${data.productoNombre || productoId}\nTotal: ${data.total || "N/A"}`,
          );
          updateSummary([
            "Flujo 3: âœ… Pedido creado usando el token del Flujo 1.",
            `Pedido devuelto: ${data.id || data.pedidoId || "N/A"}`,
            "El header Authorization fue aceptado por el backend.",
          ]);
          return data;
        } catch (error) {
          setStatus(
            "pedidoTag",
            "pedidoOut",
            "error",
            `Pedido fallÃ³: ${error.message}`,
          );
          updateSummary([
            `Flujo 3: âŒ ${error.message}`,
            "Revisa que el token se estÃ© enviando como Bearer.",
          ]);
          throw error;
        }
      }

      function verificarSesion() {
        const raw = localStorage.getItem(STORAGE_USER);
        if (!raw) {
          setStatus(
            "sesionTag",
            "sesionOut",
            "error",
            "No hay sesiÃ³n guardada en localStorage.",
          );
          updateSummary([
            "Flujo 4: âŒ No hay sesiÃ³n guardada.",
            "Ejecuta el Flujo 1 primero.",
          ]);
          return null;
        }
        try {
          const usuario = JSON.parse(raw);
          const nombre = usuario.nombre || "(vacÃ­o)";
          const rol = usuario.rol || "(vacÃ­o)";
          setStatus(
            "sesionTag",
            "sesionOut",
            "ok",
            `SesiÃ³n encontrada.\nNombre: ${nombre}\nRol: ${rol}\nCorreo: ${usuario.correo || "(vacÃ­o)"}`,
          );
          updateSummary([
            "Flujo 4: âœ… SesiÃ³n presente en localStorage.",
            `Nombre: ${nombre}`,
            `Rol: ${rol}`,
          ]);
          return usuario;
        } catch (error) {
          setStatus(
            "sesionTag",
            "sesionOut",
            "error",
            `La sesiÃ³n existe pero no se pudo leer: ${error.message}`,
          );
          return null;
        }
      }

      function limpiarSesion() {
        localStorage.removeItem(STORAGE_TOKEN);
        localStorage.removeItem(STORAGE_USER);
        setStatus("sesionTag", "sesionOut", "pending", "Pendiente...");
        updateSummary([
          "SesiÃ³n limpiada. Ejecuta de nuevo el Flujo 1 si quieres repetir la prueba.",
        ]);
      }

      document.getElementById("btnLogin").addEventListener("click", loginFlow);
      document
        .getElementById("btnCatalogo")
        .addEventListener("click", cargarCatalogo);
      document.getElementById("btnFiltrar").addEventListener("click", () => {
        if (!catalogoCache.length) {
          setStatus(
            "catalogoTag",
            "catalogoOut",
            "error",
            "Primero carga el catÃ¡logo.",
          );
          return;
        }
        const banano = catalogoCache.filter(
          (p) => String(p.tipoFruta || "").toUpperCase() === "BANANO",
        );
        setStatus(
          "catalogoTag",
          "catalogoOut",
          "ok",
          `Filtro BANANO aplicado.\nCoincidencias: ${banano.length}\n${banano.map((p) => `- ${p.nombre}`).join("\n") || "Sin coincidencias"}`,
        );
      });
      document
        .getElementById("btnPedido")
        .addEventListener("click", crearPedido);
      document
        .getElementById("btnSesion")
        .addEventListener("click", verificarSesion);
      document
        .getElementById("btnLimpiar")
        .addEventListener("click", limpiarSesion);

      updateSummary([
        "Flujo 1: pendiente",
        "Flujo 2: pendiente",
        "Flujo 3: pendiente",
        "Flujo 4: pendiente",
      ]);
    </script>
    <script type="module" src="js/site-info.js"></script>
  </body>
</html>

