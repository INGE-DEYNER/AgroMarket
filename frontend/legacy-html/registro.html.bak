              />
            </svg>
          </div>
          <div>
            <div class="brand-name">AgroMarket</div>
            <div class="brand-sub">Plataforma de comercio agrÃ­cola</div>
          </div>
        </a>

        <h1 class="page-title">Comienza tu viaje</h1>
        <p class="page-sub">
          Selecciona tu perfil y Ãºnete a la revoluciÃ³n agrÃ­cola.
        </p>

        <!-- ROLE SELECTOR -->
        <div class="role-selector">
          <button
            type="button"
            class="role-card selected"
            id="roleComprador"
          >
            <div class="role-check">
