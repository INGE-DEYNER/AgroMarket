                  stroke="#fff"
                  stroke-width="1.5"
                  fill="none"
                  stroke-linecap="round"
                />
              </svg>
            </div>
            <div class="role-icon">ðŸ›’</div>
            <div class="role-name">Comprador</div>
            <div class="role-desc">Acceso a los mejores precios de origen</div>
          </button>
          <button
            type="button"
