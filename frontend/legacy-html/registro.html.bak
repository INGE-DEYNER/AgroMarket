          <input type="hidden" id="rolSelected" value="comprador" />

          <button type="submit" class="btn-submit" id="submitBtn">
            Crear cuenta
          </button>

          <div class="success-msg" id="successMsg">
            <span>âœ”</span>
            <span>Cuenta creada. Redirigiendo a la verificaciÃ³n...</span>
          </div>
        </form>

        <div class="form-footer">
          Â¿Ya tienes cuenta? <a href="login.html">Inicia sesiÃ³n</a>
          <a
            class="btn-google"
            href="http://localhost:8080/oauth2/authorization/google"
            style="
              display: inline-flex;
              align-items: center;
              gap: 8px;
              padding: 6px 10px;
              border-radius: 8px;
              border: 1px solid #ddd;
              background: #fff;
              color: #222;
              text-decoration: none;
              margin-left: 12px;
            "
