                    gap: 6px;
                    margin-top: 10px;
                    font-size: 0.78rem;
                    color: #4e6b54;
                  "
                >
                  <div id="reqLength">â€¢ MÃ­nimo 8 caracteres</div>
                  <div id="reqUpper">â€¢ Una mayÃºscula</div>
                  <div id="reqNumber">â€¢ Un nÃºmero</div>
                  <div id="reqSpecial">â€¢ Un carÃ¡cter especial</div>
                </div>
              </div>
              <span class="form-error" id="passwordError"
                >Debe tener 8 caracteres, una mayÃºscula, un nÃºmero y un carÃ¡cter
                especial.</span
              >
            </div>
            <div class="form-group">
              <label class="form-label" for="confirmPass"
                >Confirmar contraseÃ±a</label
              >
              <input
                class="form-input"
                type="password"
                id="confirmPass"
                placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"
              />
              <span class="form-error" id="confirmError"
                >Las contraseÃ±as no coinciden.</span
              >
            </div>
          </div>

          <!-- EXTRA FIELD FOR PRODUCER -->
          <div class="form-group extra-field" id="ubicacionGroup">
            <label class="form-label" for="ubicacion">UbicaciÃ³n / Vereda</label>
            <input
              class="form-input"
