            <div class="form-group">
              <label class="form-label" for="apellido">Apellido</label>
              <input
                class="form-input"
                type="text"
                id="apellido"
                placeholder="PÃ©rez"
              />
              <span class="form-error" id="apellidoError"
                >Campo requerido.</span
              >
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="email">Correo electrÃ³nico</label>
            <input
              class="form-input"
              type="email"
              id="email"
              placeholder="tu@correo.com"
            />
            <span class="form-error" id="emailError"
              >Ingresa un correo vÃ¡lido.</span
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="telefono">TelÃ©fono</label>
            <input
              class="form-input"
              type="tel"
              id="telefono"
              placeholder="3001234567"
              maxlength="10"
              inputmode="numeric"
            />
            <span class="form-error" id="telefonoError"
              >Debe tener 10 dÃ­gitos numÃ©ricos.</span
            >
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="password">ContraseÃ±a</label>
              <input
                class="form-input"
                type="password"
                id="password"
                placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"
                minlength="8"
              />
              <div
                id="passwordStrengthWrap"
                style="
                  margin-top: 10px;
                  padding: 12px;
                  border-radius: 12px;
                  border: 1px solid rgba(45, 106, 45, 0.1);
