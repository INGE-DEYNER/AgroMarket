        <div class="right-overlay">
          <div class="right-badge">ðŸŒ¿ Plataforma oficial</div>
          <h2 class="right-title">
            Del campo de <span data-site="siteRegion">UrabÃ¡</span><br />a tu
            hogar.
          </h2>
          <p class="right-sub">
            Garantizamos trazabilidad total y precios justos para quienes
            cultivan la tierra y quienes disfrutan sus frutos.
          </p>
          <div class="right-features">
            <div class="right-feat">
              <span class="feat-icon">ðŸ”</span>
              <span class="feat-text"
                ><strong style="color: #fff">Trazabilidad total</strong
                ><br />Conoce el origen exacto de cada fruta que compras.</span
              >
            </div>
            <div class="right-feat">
              <span class="feat-icon">ðŸ’°</span>
              <span class="feat-text"
                ><strong style="color: #fff">Precios justos</strong><br />Sin
                intermediarios. Directo del productor al consumidor.</span
              >
            </div>
            <div class="right-feat">
              <span class="feat-icon">ðŸšš</span>
              <span class="feat-text"
                ><strong style="color: #fff">EnvÃ­os seguros</strong
                ><br />Seguimiento en tiempo real desde
                <span data-site="siteRegion">UrabÃ¡</span> hasta tu puerta.</span
              >
            </div>
          </div>
        </div>
      </div>
      <!-- /right-panel -->
    </div>
    <!-- /wrapper -->

    <script type="module" src="js/site-info.js"></script>
    <script type="module" src="js/registro.js"></script>
  </body>
</html>

