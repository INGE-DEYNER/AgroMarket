                  stroke-width="1.5"
                  fill="none"
                  stroke-linecap="round"
                />
              </svg>
            </div>
            <div class="role-icon">ðŸŒ¾</div>
            <div class="role-name">Productor</div>
            <div class="role-desc">Vende directamente sin intermediarios</div>
          </button>
        </div>

        <!-- FORM -->
        <form id="regForm" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="nombre">Nombre</label>
              <input
