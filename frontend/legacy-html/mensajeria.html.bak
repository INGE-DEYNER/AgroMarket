  </head>
  <body>
    <div class="page-wrap">
      <!-- NAVBAR -->
      <nav class="navbar">
        <a class="navbar-brand" href="dashboard-comprador.html">
          <span class="logo-icon">ðŸŒ¿</span><span>AgroMarket</span>
        </a>
        <div class="navbar-links" id="navLinks">
          <a href="dashboard-comprador.html">Mi Panel</a>
          <a href="catalogo.html">CatÃ¡logo</a>
          <a href="pedidos.html">Pedidos</a>
          <a href="mensajeria.html" class="active">Mensajes</a>
          <a href="envios.html">EnvÃ­os</a>
        </div>
        <div class="navbar-right" id="navActions">
          <div class="avatar avatar-blue">--</div>
          <a
            href="#"
            onclick="
              Auth.logout();
              return false;
            "
            class="btn btn-secondary btn-sm"
            >Cerrar sesiÃ³n</a
          >
        </div>
      </nav>

      <!-- CHAT LAYOUT -->
      <div class="chat-layout">
        <!-- CONTACTS -->
        <div class="chat-contacts" id="contactList"></div>

        <!-- WINDOW -->
        <div class="chat-window">
          <div class="chat-header" id="chatHeader">
            <div class="avatar avatar-green" id="chatAvatar">--</div>
            <div>
              <div class="chat-name" id="chatName">
                Selecciona una conversaciÃ³n
              </div>
              <div
                style="font-size: 0.75rem; color: var(--text-muted)"
                id="chatRole"
              ></div>
            </div>
            <div style="margin-left: auto">
              <span
                class="badge badge-green"
                id="onlineBadge"
                style="display: none"
                >â— En lÃ­nea</span
              >
            </div>
          </div>

          <div class="chat-messages" id="chatMessages">
            <div class="empty-state" style="margin: auto">
              <div class="empty-icon">ðŸ’¬</div>
              <div>Selecciona un contacto para iniciar la conversaciÃ³n.</div>
            </div>
          </div>

          <div class="chat-input-bar">
            <input
              class="chat-input"
              id="msgInput"
              placeholder="Escribe un mensaje..."
              onkeydown="handleKey(event)"
              disabled
            />
            <button
              class="btn btn-primary"
              id="sendBtn"
              onclick="sendMessage()"
              disabled
            >
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24">
                <path
                  d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
      <!-- /chat-layout -->
    </div>
    <!-- /page-wrap -->

