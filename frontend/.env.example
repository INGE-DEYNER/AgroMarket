# =============================================================================
# AgroMarket - Ejemplo de Variables de Entorno (Frontend)
# =============================================================================
# 
# COPIA este archivo a .env.local y configura los valores.
# .env.local está en .gitignore, así que no se subirá a Git.
# 
# Para producción, usa variables de entorno del sistema o del servidor web.
# =============================================================================

# -----------------------------------------------------------------------------
# API Backend
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1

# -----------------------------------------------------------------------------
# MercadoPago (REQUERIDO para pagos reales)
# -----------------------------------------------------------------------------
# Public Key de MercadoPago
# Obtén esta clave de: https://developers.mercadopago.com/
# 1. Ve a "Mis aplicaciones" > "Credenciales"
# 2. Copia el "Public Key" (Sandbox para desarrollo, Producción para producción)
# 3. Pégalo aquí
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXX-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXXX

# -----------------------------------------------------------------------------
# URLs de Callback (OPCIONAL - por defecto usa localhost:5173)
# -----------------------------------------------------------------------------
# Configure estas URLs también en el panel de MercadoPago
VITE_MERCADOPAGO_SUCCESS_URL=http://localhost:5173/pago-pasarela
VITE_MERCADOPAGO_FAILURE_URL=http://localhost:5173/pago-pasarela
VITE_MERCADOPAGO_PENDING_URL=http://localhost:5173/pago-pasarela

# -----------------------------------------------------------------------------
# Configuración Adicional
# -----------------------------------------------------------------------------
# Idioma por defecto
VITE_DEFAULT_LANGUAGE=es

# =============================================================================
# INSTRUCCIONES RÁPIDAS:
# =============================================================================
#
# 1. Crea una cuenta en MercadoPago:
#    https://www.mercadopago.com.co/
#
# 2. Ve a Developers:
#    https://developers.mercadopago.com/
#
# 3. Crea una aplicación o usa la existente
#
# 4. En "Credenciales", copia el Public Key de SANDBOX
#    (para pruebas) o de PRODUCCIÓN (para ambiente real)
#
# 5. Pega el Public Key en VITE_MERCADOPAGO_PUBLIC_KEY
#
# 6. En tu backend (agroMarket/.env), configura:
#    MERCADOPAGO_ACCESS_TOKEN=tu_access_token_de_mercadopago
#    MERCADOPAGO_USE_MOCK=false
#
# 7. Reinicía tu aplicación frontend y backend
#
# ¡Listo! Ahora puedes hacer pagos reales a través de MercadoPago.
#
# =============================================================================
