# =============================================================================
# AgroMarket - Variables de Entorno (Frontend)
# =============================================================================
#
# COPIA este archivo a .env.local y configura los valores.
# .env.local está en .gitignore, así que no se subirá a Git.
#
# Para producción, define estas variables en las configuraciones del servidor
# (Vercel, Netlify, Cloudflare Pages, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# API Backend
# -----------------------------------------------------------------------------
# Desarrollo local: http://localhost:8080/api/v1
# Producción: https://api.agro-market.app/api/v1 (via Cloudflare Tunnel)
VITE_API_URL=http://localhost:8080/api/v1

# -----------------------------------------------------------------------------
# MercadoPago (REQUERIDO para pagos reales)
# -----------------------------------------------------------------------------
# Public Key de MercadoPago
# Producción: APP_USR-xxxx-xxxx-xxxx-xxxx (obtén de https://developers.mercadopago.com)
# Desarrollo:  TEST-... (sandbox)
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key-de-produccion

# -----------------------------------------------------------------------------
# URLs de Callback (Redirecciones después de pago)
# -----------------------------------------------------------------------------
# IMPORTANTE: Configura estas mismas URLs en el panel de MercadoPago
# > Mis aplicaciones > URLs de notificación
#
# Producción:
# VITE_MERCADOPAGO_SUCCESS_URL=https://www.agro-market.app/pago-pasarela
# VITE_MERCADOPAGO_FAILURE_URL=https://www.agro-market.app/pago-pasarela
# VITE_MERCADOPAGO_PENDING_URL=https://www.agro-market.app/pago-pasarela
#
# Desarrollo:
# VITE_MERCADOPAGO_SUCCESS_URL=http://localhost:5173/pago-pasarela
# VITE_MERCADOPAGO_FAILURE_URL=http://localhost:5173/pago-pasarela
# VITE_MERCADOPAGO_PENDING_URL=http://localhost:5173/pago-pasarela
VITE_MERCADOPAGO_SUCCESS_URL=http://localhost:5173/pago-pasarela
VITE_MERCADOPAGO_FAILURE_URL=http://localhost:5173/pago-pasarela
VITE_MERCADOPAGO_PENDING_URL=http://localhost:5173/pago-pasarela

# -----------------------------------------------------------------------------
# Configuración Adicional
# -----------------------------------------------------------------------------
VITE_DEFAULT_LANGUAGE=es
NODE_ENV=development

# =============================================================================
# INSTRUCCIONES PARA PRODUCCIÓN:
# =============================================================================
#
# 1. En el backend (agroMarket/.env), configura:
#    - MERCADOPAGO_ACCESS_TOKEN=tu_token_real_de_produccion
#    - MERCADOPAGO_USE_MOCK=false
#    - MERCADOPAGO_WEBHOOK_URL=https://api.agro-market.app/api/v1/payments/webhook
#    - APP_CORS_ALLOWED_ORIGIN=https://www.agro-market.app,https://agro-market.app
#
# 2. En el frontend (.env de producción), configura:
#    - VITE_API_URL=https://api.agro-market.app/api/v1
#    - VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key-real
#
# 3. Configura el Cloudflare Tunnel para exponer api.agro-market.app → localhost:8080
#
# 4. En MercadoPago, configura las URLs de notificación:
#    https://api.agro-market.app/api/v1/payments/webhook
#
# =============================================================================
