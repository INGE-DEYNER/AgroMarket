# .env.example — Backend AgroMarket (COPIA este archivo a .env y rellena los valores)
# NO subir .env a Git (ya está en .gitignore)

SPRING_PROFILES_ACTIVE=prod

# ============================================================
# MYSQL (Docker local)
# ============================================================
SPRING_DATASOURCE_USERNAME=agromarket
SPRING_DATASOURCE_PASSWORD=agromarket
MYSQL_ROOT_PASSWORD=agromarket

# ============================================================
# JWT (genera uno seguro con: openssl rand -base64 64)
# ============================================================
JWT_SECRET=cambia-este-valor-por-uno-seguro
JWT_EXPIRATION_MS=3600000

# ============================================================
# SEGURIDAD / CIFRADO de IDs (AES-256)
# ============================================================
APP_SECURITY_ID_ENCRYPTION_KEY=cambia-este-valor

# ============================================================
# CORS / OAUTH2 — DOMINIO REAL (PRODUCCIÓN)
# ============================================================
APP_CORS_ALLOWED_ORIGIN=https://www.agro-market.app,https://agro-market.app
APP_OAUTH2_SUCCESS_REDIRECT=https://www.agro-market.app/oauth2/success
APP_OAUTH2_FAILURE_REDIRECT=https://www.agro-market.app/oauth2/failure
APP_OAUTH2_DEFAULT_ROLE=BUYER

# Google OAuth2 (obtenido de https://console.cloud.google.com/)
GOOGLE_OAUTH2_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=tu_client_secret
GOOGLE_OAUTH2_REDIRECT_URI=https://api.agro-market.app/login/oauth2/code/google

# ============================================================
# MERCADO PAGO (https://developers.mercadopago.com)
# ============================================================
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_de_produccion
MERCADOPAGO_USE_MOCK=false
MERCADOPAGO_WEBHOOK_URL=https://api.agro-market.app/api/v1/payments/webhook

# ============================================================
# CLOUDINARY (https://cloudinary.com/console)
# ============================================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ============================================================
# BREVO (https://app.brevo.com/settings/keys)
# ============================================================
BREVO_API_KEY=tu_brevo_api_key
BREVO_SENDER_EMAIL=noreply@agro-market.app
BREVO_SENDER_NAME=AgroMarket
FRONTEND_URL=https://www.agro-market.app

# ============================================================
# SCHEDULERS
# ============================================================
PROMOTIONS_JOB_DELAY_MS=300000
RFQ_JOB_DELAY_MS=300000
ID_ENCRYPTION_KEY=cambia-este-valor

