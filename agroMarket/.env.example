# Mail settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_password_or_app_password

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT secret
JWT_SECRET=change_this_secret

# MongoDB auth audit store
MONGO_URI=mongodb://localhost:27018/agromarket_auth
MONGO_DATABASE=agromarket_auth
